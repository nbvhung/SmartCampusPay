{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    @api path /api/*
    handle @api {
        reverse_proxy backend:4000 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy frontend:3000 {
            header_up X-Forwarded-For {remote_host}
        }
    }
}
