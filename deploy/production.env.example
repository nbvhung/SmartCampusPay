# Copy to repository root as .env.production, chmod 600. Never commit real values.
# DOMAIN must be a hostname only; DNS A/AAAA must point to this VPS.
DOMAIN=pay.example.edu.vn
ACME_EMAIL=operator@example.edu.vn
RELEASE_TAG=replace-with-git-sha
IMAGE_PREFIX=smartcampuspay
# Generate EACH secret separately: openssl rand -hex 32
DB_PASS=replace-with-random-secret
JWT_ACCESS_SECRET=replace-with-random-secret
JWT_REFRESH_SECRET=replace-with-random-secret
DEFAULT_ADMIN_USERNAME=campus-admin
DEFAULT_ADMIN_PASSWORD=replace-with-random-bootstrap-password
SEPAY_API_KEY=
SEPAY_BANK_ID=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_ACCOUNT_NUMBER=
