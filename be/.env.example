PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=smartcampuspay
DB_SYNCHRONIZE=false

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

FRONTEND_URL=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379

# Registration OTP / SMS
# Only "mock" is implemented for development and test. Production must provide
# a real SmsSender implementation before setting a different provider name.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_MOCK_LOG_OTP=false

# Use a random secret of at least 32 bytes in production.
OTP_HMAC_SECRET=replace-with-a-long-random-otp-hmac-secret
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_RATE_LIMIT_PER_STUDENT=5
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_CLIENT=20
# Optional namespace override, useful when several environments share Redis.
OTP_REDIS_PREFIX=scp:registration-otp

# SePay (cổng thanh toán ngân hàng)
SEPAY_API_KEY=
SEPAY_BANK_ID=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
# Optional: actual recipient accountNumber from SePay webhook when QR uses a virtual account.
SEPAY_WEBHOOK_ACCOUNT_NUMBER=
SEPAY_QR_BASE=https://qr.sepay.vn/img
SEPAY_STATIC_QR_DES=Nap tien SmartCampusPay - ghi ro ma SV
